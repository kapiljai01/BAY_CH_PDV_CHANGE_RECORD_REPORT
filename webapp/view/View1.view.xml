<mvc:View
    controllerName="changerecordreport.controller.View1"
   xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:ui="sap.ui.table"
    xmlns="sap.m"
    xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    height="100%"
>
    <!-- use this to make the table occupy the available screen height -->
    <f:DynamicPage
        id="dynamicPage"
        headerPinned="true"
    >
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>title}" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <!-- Header (where SmartFilterBar goes) -->
        <f:header>
            <f:DynamicPageHeader>
                <!-- Smart Filter Bar in header -->
                <smartFilterBar:SmartFilterBar
                    id="smartFilterBar"
                    enableBasicSearch="true"
                    entitySet="ChangeRecord"
                    useToolbar="true"
                    showClearOnFB="true"
                    basicSearchFieldName="CRDetailDescription"
                    persistencyKey="SmartFilterBarKey"
                >
                    <smartFilterBar:layoutData>
                        <FlexItemData shrinkFactor="0" />
                    </smartFilterBar:layoutData>
                </smartFilterBar:SmartFilterBar>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <!-- Table scrolls -->
            <VBox
				fitContainer="true"
				height="100%"
			>
            <smartTable:SmartTable
                id="LineItemsSmartTable"
                entitySet="ChangeRecord"
                smartFilterId="smartFilterBar"
                tableType="Table"
                exportType="UI5ClientPDF"
                enableExport="true"
                enableAutoBinding="true"
                header="List of Items"
                customData:useSmartField="true"
                showRowCount="true"
                initiallyVisibleFields="ChangeRecord"
                useColumnLabelsAsTooltips="true"
                showVariantManagement="true"
                persistencyKey="ChangeRecordTableKey"
                enableAutoColumnWidth="true"
                showFullScreenButton="true"
                class="sapUiResponsiveContentPadding"
                width="100%"
                height="100%"
                beforeRebindTable="onBeforeRebindTable"
            >
                <ui:Table
                    id="idGenTable"
                    alternateRowColors="true"
                    columnHeaderVisible="true"
                    enableColumnReordering="false"
                    enableCellFilter="true"
                >
                    <ui:Column
                        id="idGenColumn"
                        width="11rem"
                        sortProperty="ChangeRecord"
                        filterProperty="ChangeRecord"
                        autoResizable="true"
                    >
                        <Label
                            id="_IDGenLabel"
                            text="{i18n>changerecord}"
                        />
                        <ui:template>
                            <Link
                                id="_IDGenLink"
                                text="{ChangeRecord}"
                                press=".onChangeRecordPress"
                            />
                        </ui:template>
                        <!-- SmartTable personalization info -->
                        <ui:customData>
                            <core:CustomData
                                key="p13nData"
                                value="{
                                    columnKey: 'ChangeRecord',
                                    leadingProperty: 'ChangeRecord',
                                    sortProperty: 'ChangeRecord',
                                    filterProperty: 'ChangeRecord'
                                }"
                            />
                        </ui:customData>
                    </ui:Column>
                </ui:Table>
                <!-- layout data used to make the table growing but the filter bar fixed -->
                <smartTable:layoutData>
                    <FlexItemData
                        id="_IDGenFlexItemData1"
                        growFactor="1"
                        baseSize="0%"
                    />
                </smartTable:layoutData>
            </smartTable:SmartTable>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
